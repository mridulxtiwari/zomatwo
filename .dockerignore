# ==============================================================
# Root .dockerignore for Zomatwo Platform
# Prevents large or sensitive files from bloating the Docker build context
# ==============================================================

# Git repository metadata
.git/
.gitignore
.gitattributes

# Local build artifacts
**/target/
target/
*.class
*.jar
*.war
*.original

# Node dependencies and build outputs
**/node_modules/
node_modules/
**/dist/
dist/
dist-ssr/

# IDE and editor files
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.code-workspace
.classpath
.project
.settings/

# Local environment & secrets
.env
.env.*
*.env
*.pem
*.key

# Documentation and markdown files (not needed inside container images)
*.md
docs/

# Compose and deployment specs
docker-compose*.yml
render*.yaml

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Logs and temporary files
*.log
logs/
*.tmp
*.bak
*~
