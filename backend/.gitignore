target/
**/target/
*.class
*.jar
*.war
*.original

# Maven local runtime files
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/.develocity/
.flattened-pom.xml

# Crash logs
hs_err_pid*
replay_pid*

# IDEs
.idea/
*.iml
.classpath
.project
.settings/
.factorypath
