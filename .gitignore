# ==============================================================
# Root .gitignore for Zomatwo Platform
# ==============================================================

# --------------------------------------------------------------
# Java & Maven Build Artifacts
# --------------------------------------------------------------
**/target/
target/
*.class
*.jar
*.war
*.ear
*.nar
*.original
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Maven release and plugin temporary files
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/.develocity/
.flattened-pom.xml

# --------------------------------------------------------------
# Node & Frontend (React / Vite)
# --------------------------------------------------------------
**/node_modules/
node_modules/
**/dist/
dist/
dist-ssr/
*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Cache directories
.eslintcache
.stylelintcache
.vite/
.turbo/

# --------------------------------------------------------------
# IDEs & Code Editors
# --------------------------------------------------------------
# JetBrains (IntelliJ IDEA)
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# Sublime Text
*.sublime-workspace
*.sublime-project

# --------------------------------------------------------------
# Operating System Files
# --------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --------------------------------------------------------------
# Logs, Temp, and Database Volumes
# --------------------------------------------------------------
*.log
logs/
*.tmp
*.bak
*.swp
*~
postgres_data/
redis_data/
kafka_data/
